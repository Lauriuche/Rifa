<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Acesso</title>
  <style>
    :root {
      --bg: #121314;
      --card: #1c1d1f;
      --border: #2e3035;
      --text: #9a9aa3;
      --title: #eeeef2;
      --primary: #008b77;
      --danger: #ff4d4d;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
      background: radial-gradient(ellipse at top, #1a2220 0%, var(--bg) 55%);
      color: var(--title);
      padding: 20px;
    }
    .card {
      width: 100%;
      max-width: 360px;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 28px 22px 22px;
      box-shadow: 0 16px 48px rgba(0,0,0,.35);
    }
    .icon {
      width: 56px; height: 56px;
      margin: 0 auto 16px;
      border-radius: 50%;
      background: #2a2c31;
      border: 1px solid var(--border);
      display: flex; align-items: center; justify-content: center;
      font-size: 22px;
    }
    h1 { text-align: center; font-size: 18px; margin-bottom: 6px; }
    p.sub { text-align: center; font-size: 12px; color: var(--text); margin-bottom: 20px; }
    label { display: block; font-size: 12px; color: var(--text); margin-bottom: 6px; }
    input[type="password"], input[type="text"] {
      width: 100%;
      padding: 14px 12px;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: #151617;
      color: var(--title);
      font-size: 22px;
      font-weight: 700;
      letter-spacing: 10px;
      text-align: center;
      outline: none;
    }
    input:focus { border-color: var(--primary); }
    .row {
      display: flex; align-items: center; gap: 8px;
      margin: 14px 0 18px;
      font-size: 13px; color: var(--text);
    }
    .row input { width: 16px; height: 16px; accent-color: var(--primary); letter-spacing: 0; }
    button {
      width: 100%;
      border: none;
      border-radius: 10px;
      padding: 14px;
      font-weight: 800;
      font-size: 14px;
      cursor: pointer;
      background: var(--primary);
      color: #fff;
    }
    button:disabled { opacity: .55; cursor: not-allowed; }
    .msg {
      margin-top: 14px;
      text-align: center;
      font-size: 13px;
      min-height: 18px;
      color: var(--text);
    }
    .msg.err { color: var(--danger); }
    .msg.ok { color: #00db87; }
    .hint {
      margin-top: 18px;
      font-size: 11px;
      color: var(--text);
      text-align: center;
      line-height: 1.4;
      opacity: .75;
    }
  </style>
</head>
<body>
  <div class="card">
    <div class="icon">🔒</div>
    <h1>Acesso restrito</h1>
    <p class="sub">Digite o PIN de administrador</p>

    <label for="pin">PIN</label>
    <input id="pin" type="password" maxlength="12" inputmode="numeric" autocomplete="current-password" autofocus />

    <label class="row">
      <input id="remember" type="checkbox" checked />
      Lembrar neste aparelho (7 dias)
    </label>

    <button id="btn" type="button">Entrar</button>
    <div class="msg" id="msg"></div>
    <p class="hint">Após validar, você será levado ao painel da rifa.</p>
  </div>

  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/11.0.1/firebase-app.js";
    import { getDatabase, ref, get } from "https://www.gstatic.com/firebasejs/11.0.1/firebase-database.js";

    const firebaseConfig = {
      apiKey: "AIzaSyBfiZPr24kg4O04VFYh6SXdHE257N6Xwng",
      authDomain: "vagner-34d5b.firebaseapp.com",
      databaseURL: "https://vagner-34d5b.firebaseio.com",
      projectId: "vagner-34d5b",
      storageBucket: "vagner-34d5b.firebasestorage.app",
      messagingSenderId: "711539772164",
      appId: "1:711539772164:web:e5c0457cb69f8e7d0bde51"
    };

    const params = new URLSearchParams(location.search);
    const tenantId = params.get("tenant") || "rifa_master";
    const rifaId = params.get("rifa") || "padrao";
    const dbPath = tenantId === "rifa_master" ? "rifa_master" : `tenants/${tenantId}/rifas/${rifaId}`;

    // Destino após login (mesma pasta / site)
    const INDEX_URL = (() => {
      const base = location.pathname.replace(/[^/]+$/, "") || "/";
      const q = new URLSearchParams();
      if (tenantId && tenantId !== "rifa_master") q.set("tenant", tenantId);
      if (rifaId && rifaId !== "padrao") q.set("rifa", rifaId);
      q.set("admin", "1");
      const qs = q.toString();
      return base + "index.html" + (qs ? "?" + qs : "");
    })();

    const app = initializeApp(firebaseConfig);
    const db = getDatabase(app);

    const pinEl = document.getElementById("pin");
    const btn = document.getElementById("btn");
    const msg = document.getElementById("msg");
    const rememberEl = document.getElementById("remember");

    const FAIL_KEY = "rifa_pin_fails";
    const LOCK_KEY = "rifa_pin_lock";
    const SESSION_KEY = "rifa_admin_session";

    function setMsg(text, type) {
      msg.textContent = text || "";
      msg.className = "msg" + (type ? " " + type : "");
    }

    function isLocked() {
      const until = parseInt(localStorage.getItem(LOCK_KEY) || "0", 10) || 0;
      return Date.now() < until ? until : 0;
    }

    async function loadPin() {
      const snap = await get(ref(db, `${dbPath}/config/pin`));
      return snap.exists() ? String(snap.val() || "").trim() : "";
    }

    async function tryLogin() {
      const until = isLocked();
      if (until) {
        const min = Math.ceil((until - Date.now()) / 60000);
        setMsg(`PIN bloqueado. Tente em ${min} min.`, "err");
        return;
      }

      const typed = (pinEl.value || "").trim();
      if (!typed) {
        setMsg("Digite o PIN.", "err");
        pinEl.focus();
        return;
      }

      btn.disabled = true;
      setMsg("Validando…");

      try {
        const realPin = await loadPin();
        if (!realPin) {
          setMsg("PIN do admin ainda não foi definido nas configurações.", "err");
          btn.disabled = false;
          return;
        }

        if (typed === realPin) {
          localStorage.setItem(FAIL_KEY, "0");
          localStorage.setItem(LOCK_KEY, "0");
          if (rememberEl.checked) {
            localStorage.setItem(SESSION_KEY, JSON.stringify({ ok: true, exp: Date.now() + 7 * 24 * 60 * 60 * 1000 }));
          } else {
            // sessão curta (aba atual): 2h
            localStorage.setItem(SESSION_KEY, JSON.stringify({ ok: true, exp: Date.now() + 2 * 60 * 60 * 1000 }));
          }
          setMsg("Acesso liberado. Abrindo painel…", "ok");
          setTimeout(() => { location.href = INDEX_URL; }, 400);
          return;
        }

        let fails = (parseInt(localStorage.getItem(FAIL_KEY) || "0", 10) || 0) + 1;
        localStorage.setItem(FAIL_KEY, String(fails));
        if (fails >= 5) {
          const lockUntil = Date.now() + 15 * 60 * 1000;
          localStorage.setItem(LOCK_KEY, String(lockUntil));
          setMsg("Muitas tentativas. Bloqueado por 15 min.", "err");
        } else {
          setMsg(`PIN incorreto. (${fails}/5)`, "err");
        }
        pinEl.value = "";
        pinEl.focus();
      } catch (e) {
        console.error(e);
        setMsg("Erro ao conectar. Tente de novo.", "err");
      } finally {
        btn.disabled = false;
      }
    }

    // Já logado? vai direto
    try {
      const s = JSON.parse(localStorage.getItem(SESSION_KEY) || "null");
      if (s && s.ok && s.exp > Date.now()) {
        setMsg("Sessão ativa. Abrindo…", "ok");
        location.replace(INDEX_URL);
      }
    } catch (_) {}

    btn.addEventListener("click", tryLogin);
    pinEl.addEventListener("keydown", (e) => {
      if (e.key === "Enter") tryLogin();
    });
  </script>
</body>
</html>
