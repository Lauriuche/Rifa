const express = require('express');
const cors = require('cors');
const { MercadoPagoConfig, Payment } = require('mercadopago');
const admin = require('firebase-admin');

const app = express();
app.use(cors());
app.use(express.json());

// Inicializar Firebase Admin (Acesso root seguro ao banco)
// As credenciais virão das Variáveis de Ambiente do Render
try {
    if (process.env.FIREBASE_CREDENTIALS) {
        const serviceAccount = JSON.parse(process.env.FIREBASE_CREDENTIALS);
        admin.initializeApp({
            credential: admin.credential.cert(serviceAccount),
            databaseURL: "https://vagner-34d5b.firebaseio.com" // URL do seu Firebase
        });
        console.log("🔥 Firebase Admin Inicializado com Sucesso!");
    } else {
        console.warn("⚠️ FIREBASE_CREDENTIALS não encontrado no ambiente.");
    }
} catch (error) {
    console.error("Erro ao inicializar Firebase:", error);
}

const db = admin.database ? admin.database() : null;

// ==========================================
// ROTA 1: CRIAR PIX NO MERCADO PAGO
// ==========================================
app.post('/api/create-pix', async (req, res) => {
    try {
        const { tenantId, rifaId, payData, mpToken } = req.body;

        const client = new MercadoPagoConfig({ accessToken: mpToken });
        const payment = new Payment(client);

        // URL do Webhook do seu servidor no Render
        const webhookUrl = `${process.env.BACKEND_URL}/api/webhook?tenant=${tenantId}&rifa=${rifaId}`;

        const request = {
            transaction_amount: payData.priceCents / 100,
            description: payData.description,
            payment_method_id: 'pix',
            payer: {
                email: "cliente@rifamaster.com.br",
                first_name: payData.nome
            },
            external_reference: payData.nsu, // Chave para achar o bilhete depois
            notification_url: webhookUrl
        };

        const result = await payment.create({ body: request });

        res.json({
            id: result.id,
            qr_code: result.point_of_interaction.transaction_data.qr_code,
            qr_code_base64: result.point_of_interaction.transaction_data.qr_code_base64
        });
    } catch (error) {
        console.error("Erro MP:", error);
        res.status(500).json({ error: 'Erro ao gerar PIX' });
    }
});

// ==========================================
// ROTA 2: CHECAR STATUS DO PIX (Polling)
// ==========================================
app.get('/api/check-status/:id', async (req, res) => {
    try {
        const { token } = req.query;
        const client = new MercadoPagoConfig({ accessToken: token });
        const payment = new Payment(client);
        const paymentInfo = await payment.get({ id: req.params.id });
        res.json({ status: paymentInfo.status });
    } catch(e) {
        res.status(500).json({ status: 'error' });
    }
});

// ==========================================
// ROTA 3: CRIAR LINK INFINITEPAY
// ==========================================
app.post('/api/create-infinitepay', async (req, res) => {
    try {
        const { payData, handle } = req.body;
        const payload = {
            "handle": handle,
            "order_nsu": payData.nsu,
            "customer": { "name": payData.nome, "phone_number": "55" + payData.telefone.replace(/\D/g,''), "email": "cliente@rifamaster.com.br" },
            "items": [{"quantity": 1, "price": payData.priceCents, "description": payData.description }]
        };
        
        const response = await fetch('https://api.infinitepay.io/invoices/public/checkout/links', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });
        const data = await response.json();
        
        if(data.url || data.checkout_url) {
            res.json({ url: data.url || data.checkout_url });
        } else {
            res.status(400).json({ error: 'Erro na API InfinitePay' });
        }
    } catch(e) {
        res.status(500).json({ error: 'Erro interno InfinitePay' });
    }
});

// ==========================================
// ROTA 4: WEBHOOKS (Baixa Automática)
// ==========================================
app.post('/api/webhook', async (req, res) => {
    try {
        const { tenant, rifa } = req.query;
        const action = req.body.action;
        const dataData = req.body.data;

        if (action === 'payment.updated' && dataData && dataData.id && db) {
            const paymentId = dataData.id;
            const dbPath = tenant === 'rifa_master' ? 'rifa_master' : `tenants/${tenant}/rifas/${rifa}`;
            
            // Buscar token daquele tenant no Firebase
            const configSnap = await db.ref(`${dbPath}/config`).once('value');
            const config = configSnap.val();

            if(config && config.mpToken) {
                const client = new MercadoPagoConfig({ accessToken: config.mpToken });
                const payment = new Payment(client);
                const paymentInfo = await payment.get({ id: paymentId });

                if (paymentInfo.status === 'approved') {
                    const nsu = paymentInfo.external_reference;
                    const numRef = db.ref(`${dbPath}/numeros`);
                    const numSnap = await numRef.once('value');
                    const numeros = numSnap.val();

                    if (numeros) {
                        const updates = {};
                        Object.entries(numeros).forEach(([num, data]) => {
                            if (data.order_nsu === nsu && data.status !== 'paid') {
                                updates[`${num}/status`] = 'paid';
                            }
                        });

                        if (Object.keys(updates).length > 0) {
                            await numRef.update(updates);
                            console.log(`✅ Pagamento NSU: ${nsu} aprovado via Webhook!`);
                        }
                    }
                }
            }
        }
        // Sempre retorne 200 OK para o Mercado Pago parar de enviar
        res.status(200).send('OK');
    } catch (error) {
        console.error('Erro no webhook:', error);
        res.status(500).send('Erro');
    }
});

const PORT = process.env.PORT || 3000;
app.listen(PORT, () => {
    console.log(`🚀 Servidor SaaS rodando na porta ${PORT}`);
});